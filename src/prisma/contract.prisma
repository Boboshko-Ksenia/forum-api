// use prisma-8

model Post {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  content    String
  authorId   Int
  author     User     @relation(fields: [authorId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[]
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  posts        Post[]
}